POSTGRES_DB=letscook
POSTGRES_USER=letscook
POSTGRES_PASSWORD=letscook_dev
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=lets-cook-dev-livekit-secret-32-chars
# Cloudflare Quick Tunnel publishes the web app but not LiveKit's WebRTC media
# ports. For global voice/screen sharing, use a public LiveKit endpoint here.
# The browser connects to this endpoint only after mic, speaker, or screen share
# is activated. OTT/YouTube playback, queue, chat, and sync stay on this laptop.
# Leave this blank to use the bundled local LiveKit server for LAN development.
# Example: wss://your-project.livekit.cloud
LIVEKIT_PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

